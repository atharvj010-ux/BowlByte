# Supabase cutover. Leave these empty until the dashboard values exist.
# NEXT_PUBLIC_ values may reach the browser. Never put the secret key or database URI in one.
# SUPABASE_SECRET_KEY is the server-only secret (sb_secret_...), not the publishable key.
# SUPABASE_DB_URL is the session pooler URI on port 5432 with sslmode=verify-full.
# Do not use the transaction pooler on port 6543. Do not set sslmode=disable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=

# BowlByte local development examples.
# These are not production secrets. Do not put real credentials in this file.
# Copy to .env for local overrides. .env is gitignored.
# The live database is SUPABASE_DB_URL, not a local PostgreSQL service.
# Disposable tests use 127.0.0.1:55432/bowlbyte_e2e and Redis database 15.

REDIS_URL=redis://127.0.0.1:6379/0

ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:3010

# The browser calls /api/v1 on the web origin. The Next.js server forwards that path to the API.
# Local and CI set this to the API process. On Vercel, the frontend service binding injects
# API_INTERNAL_URL at runtime. Do not also set API_INTERNAL_URL in the Vercel project settings.
API_INTERNAL_URL=http://127.0.0.1:8010
PUBLIC_APP_URL=http://127.0.0.1:3010
# On Vercel set PUBLIC_APP_URL and CORS_ORIGINS to the HTTPS site origin, e.g.
# https://bowlbyte.vercel.app. Unsafe methods (login) are rejected when Origin
# is missing from that allowlist. VERCEL_URL is also accepted automatically.
COOKIE_SECURE=false

# disabled | open | institutional_domain | roster
# open accepts any email with a name and roll number. Use it for local testing.
COLLEGE_ELIGIBILITY_MODE=open
COLLEGE_NAME=Pilot College
COLLEGE_SLUG=pilot
COLLEGE_EMAIL_DOMAIN=
CANTEEN_NAME=Pilot Canteen
CANTEEN_SLUG=pilot

# P017 initial Admin desk identities. Put real operator emails in .env only.
# Do not commit production addresses. Passwords are never stored here.
# Optional one-shot Auth create: BOWLBYTE_INITIAL_STAFF_PASSWORD (shell only, never commit).
# BOWLBYTE_INITIAL_KITCHEN_EMAIL=
# BOWLBYTE_INITIAL_MANAGER_EMAIL=
# BOWLBYTE_INITIAL_CASHIER_EMAIL=
# BOWLBYTE_INITIAL_CANTEEN_ID=

# Transactional mail. Put the real Brevo host, verified sender, and SMTP credentials in .env only.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
SMTP_USE_TLS=false

# Kitchen estimates. Defaults match app/core/config.py.
# KITCHEN_PACKING_BUFFER_SECONDS=120
# KITCHEN_ETA_UNCERTAINTY_RATIO=0.2
# KITCHEN_ETA_MIN_UNCERTAINTY_SECONDS=60
# KITCHEN_OVERDUE_REMAINDER_SECONDS=60
# KITCHEN_MAX_TASKS_PER_ORDER=40

# P005 pickup credentials and Web Push.
# Generate real values with:  python -m app.cli.generate_vapid
# It prints VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, PICKUP_HASH_KEY and PUSH_ENCRYPTION_KEY to the terminal.
# Put them in .env (gitignored) or a secret store. Never commit them. Never reuse these examples.
# VAPID_PRIVATE_KEY is read only by the Celery worker, which signs and sends pushes.
# Production refuses to start with the dev-only defaults or with PUSH_ALLOW_TEST_ENDPOINTS=true.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bowlbyte.local
PICKUP_HASH_KEY=dev-only-pickup-hash-key-change-me
PUSH_ENCRYPTION_KEY=dev-only-push-encryption-key-change-me
# Only for automated tests. Routes the reserved host push-test.bowlbyte.invalid to a simulator.
PUSH_ALLOW_TEST_ENDPOINTS=false
# Defaults match app/core/config.py.
# PICKUP_CREDENTIAL_TTL_SECONDS=600
# PICKUP_ISSUE_LIMIT=6
# PICKUP_ISSUE_WINDOW_SECONDS=600
# PICKUP_VERIFY_FAILURE_LIMIT=10
# PICKUP_TICKET_FAILURE_LIMIT=5
# PICKUP_FAILURE_WINDOW_SECONDS=900
# PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,*.push.services.mozilla.com,*.notify.windows.com,web.push.apple.com,*.push.apple.com
# PUSH_MAX_ATTEMPTS=5
# PUSH_BACKOFF_BASE_SECONDS=30
# PUSH_BACKOFF_MAX_SECONDS=3600
# PUSH_TIMEOUT_SECONDS=8
# PUSH_TTL_SECONDS=1800
# PUSH_EVENT_MAX_AGE_SECONDS=1800
# NOTIFICATION_BEAT_SECONDS=15

# P006 food intelligence. Order service_date stays the UTC date from placement.
# CANTEEN_TIMEZONE=Asia/Kolkata
# FORECAST_MIN_BASELINE_DAYS=7
# FORECAST_MIN_ML_DAYS=28
# FORECAST_HOLDOUT_DAYS=7
# FORECAST_SEED=7
# FORECAST_ARTIFACT_DIR=var/forecast_artifacts
# PLANNING_SHORTAGE_WEIGHT=3
# PLANNING_OVERPRODUCTION_WEIGHT=1
# PLANNING_WINDOW_SECONDS=10800
# PLANNING_BUFFER_RATIO=0
# INTELLIGENCE_JOB_LIMIT=4
# INTELLIGENCE_JOB_WINDOW_SECONDS=600

# Shared by the web proxy and the API so browser-supplied forwarding headers are ignored.
# Replace this before any deployment.
PROXY_SHARED_SECRET=change-me-proxy-secret
# Set true only when BowlByte sits behind the documented TLS proxy (deploy/Caddyfile).
# The proxy appends the client address. The API trusts x-bowlbyte-client, never X-Forwarded-For.
# TRUST_PROXY=false
# Pickup hold after READY. QR credentials stay on their own 10-minute lifetime.
# PICKUP_HOLD_DEFAULT_MINUTES=30
# PICKUP_HOLD_WARN_LEAD_MINUTES=10
# UNCLAIMED_BEAT_SECONDS=60
# PUSH_BACKLOG_WARN_EVENTS=25
# PUSH_OLDEST_PENDING_WARN_SECONDS=300
