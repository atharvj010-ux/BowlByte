# BowlByte local development examples.
# These are not production secrets. Do not put real credentials in this file.
# Copy to .env if you want Docker Compose or local tools to read overrides.
# .env is gitignored.

POSTGRES_USER=bowlbyte
POSTGRES_PASSWORD=bowlbyte
POSTGRES_DB=bowlbyte

# Host tools use localhost. Containers use the service names in docker-compose.yml.
DATABASE_URL=postgresql+psycopg://bowlbyte:bowlbyte@localhost:5432/bowlbyte
REDIS_URL=redis://localhost:6379/0

# Optional host port overrides when the defaults are already taken.
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# BACKEND_PORT=8000
# FRONTEND_PORT=3000

ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Browser-facing API origin used by older notes. The browser now calls /api/v1 on the web origin.
# The Next.js server forwards that path to API_INTERNAL_URL.
NEXT_PUBLIC_API_URL=http://localhost:8000
API_INTERNAL_URL=http://127.0.0.1:8000
PUBLIC_APP_URL=http://127.0.0.1:3000
COOKIE_SECURE=false

# disabled | institutional_domain | roster
# Leave disabled until the college domain or roster is ready.
COLLEGE_ELIGIBILITY_MODE=disabled
COLLEGE_NAME=Pilot College
COLLEGE_SLUG=pilot
COLLEGE_EMAIL_DOMAIN=
CANTEEN_NAME=Pilot Canteen
CANTEEN_SLUG=pilot

# Local Mailpit. Containers use the mailpit hostname; host tools use 127.0.0.1.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM=BowlByte <noreply@bowlbyte.local>
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_USE_TLS=false
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Kitchen estimates. Defaults match app/core/config.py.
# KITCHEN_PACKING_BUFFER_SECONDS=120
# KITCHEN_ETA_UNCERTAINTY_RATIO=0.2
# KITCHEN_ETA_MIN_UNCERTAINTY_SECONDS=60
# KITCHEN_OVERDUE_REMAINDER_SECONDS=60
# KITCHEN_MAX_TASKS_PER_ORDER=40

# P005 pickup credentials and Web Push.
# Generate real values with:  python -m app.cli.generate_vapid
# It prints VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY, PICKUP_HASH_KEY and PUSH_ENCRYPTION_KEY to the terminal.
# Put them in .env (gitignored) or a secret store. Never commit them. Never reuse these examples.
# VAPID_PRIVATE_KEY is passed only to the worker container, which signs and sends pushes.
# Production refuses to start with the dev-only defaults or with PUSH_ALLOW_TEST_ENDPOINTS=true.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bowlbyte.local
PICKUP_HASH_KEY=dev-only-pickup-hash-key-change-me
PUSH_ENCRYPTION_KEY=dev-only-push-encryption-key-change-me
# Only for automated tests. Routes the reserved host push-test.bowlbyte.invalid to a simulator.
PUSH_ALLOW_TEST_ENDPOINTS=false
# Defaults match app/core/config.py.
# PICKUP_CREDENTIAL_TTL_SECONDS=600
# PICKUP_ISSUE_LIMIT=6
# PICKUP_ISSUE_WINDOW_SECONDS=600
# PICKUP_VERIFY_FAILURE_LIMIT=10
# PICKUP_TICKET_FAILURE_LIMIT=5
# PICKUP_FAILURE_WINDOW_SECONDS=900
# PUSH_ALLOWED_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,*.push.services.mozilla.com,*.notify.windows.com,web.push.apple.com,*.push.apple.com
# PUSH_MAX_ATTEMPTS=5
# PUSH_BACKOFF_BASE_SECONDS=30
# PUSH_BACKOFF_MAX_SECONDS=3600
# PUSH_TIMEOUT_SECONDS=8
# PUSH_TTL_SECONDS=1800
# PUSH_EVENT_MAX_AGE_SECONDS=1800
# NOTIFICATION_BEAT_SECONDS=15

# P006 food intelligence. Order service_date stays the UTC date from placement.
# CANTEEN_TIMEZONE=Asia/Kolkata
# FORECAST_MIN_BASELINE_DAYS=7
# FORECAST_MIN_ML_DAYS=28
# FORECAST_HOLDOUT_DAYS=7
# FORECAST_SEED=7
# FORECAST_ARTIFACT_DIR=var/forecast_artifacts
# PLANNING_SHORTAGE_WEIGHT=3
# PLANNING_OVERPRODUCTION_WEIGHT=1
# PLANNING_WINDOW_SECONDS=10800
# PLANNING_BUFFER_RATIO=0
# INTELLIGENCE_JOB_LIMIT=4
# INTELLIGENCE_JOB_WINDOW_SECONDS=600

# Shared by the web proxy and the API so browser-supplied forwarding headers are ignored.
# Replace this before any deployment.
PROXY_SHARED_SECRET=change-me-proxy-secret
