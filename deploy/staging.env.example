# Copy to a gitignored file before any staging start. These values are placeholders.
# Do not put real secrets in this example. Do not point staging at the development database.

POSTGRES_USER=bowlbyte_staging
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=bowlbyte
PUBLIC_APP_URL=https://canteen.example.edu
BOWLBYTE_SITE_ADDRESS=canteen.example.edu
STAGING_HTTPS_PORT=8443

PROXY_SHARED_SECRET=replace-with-a-long-random-proxy-secret
PICKUP_HASH_KEY=replace-with-a-long-random-pickup-key
PUSH_ENCRYPTION_KEY=replace-with-a-long-random-push-key
VAPID_PUBLIC_KEY=replace-with-generated-public-key
VAPID_PRIVATE_KEY=replace-with-generated-private-key
VAPID_SUBJECT=mailto:canteen@example.edu

COLLEGE_ELIGIBILITY_MODE=roster
COLLEGE_NAME=Pilot College
COLLEGE_SLUG=pilot
COLLEGE_EMAIL_DOMAIN=
CANTEEN_NAME=Pilot Canteen
CANTEEN_SLUG=pilot
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=BowlByte <noreply@bowlbyte.local>
