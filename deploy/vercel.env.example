# Copy these into the Vercel project Environment Variables (Production).
# Apply them to both services when the dashboard lets you scope by service.
# Do not commit real secrets. Values below are placeholders only.

# Public site (fixes CSRF origin checks for login)
PUBLIC_APP_URL=https://bowlbyte.vercel.app
CORS_ORIGINS=https://bowlbyte.vercel.app
COOKIE_SECURE=true
ENVIRONMENT=production
PROXY_SHARED_SECRET=replace-with-a-long-random-proxy-secret

# Supabase application database (session pooler :5432, sslmode=verify-full)
# Either set DATABASE_URL already rewritten for psycopg, or set SUPABASE_DB_URL
# and leave DATABASE_URL unset so the API rewrites it the same way start-dev.ps1 does.
# Do NOT include a Windows sslrootcert=C:/... path. The API uses app/certs/prod-ca-2021.crt.
SUPABASE_DB_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Required for login rate limits, sessions helpers, and live features.
# Vercel has no local Redis. Add Upstash (or another Marketplace Redis) and paste the URL.
# Use the rediss:// TLS URL from the provider dashboard.
REDIS_URL=rediss://default:PASSWORD@HOST:6379

# Mail and push — copy from your working local .env (gitignored)
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
PICKUP_HASH_KEY=
PUSH_ENCRYPTION_KEY=
