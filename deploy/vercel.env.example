# Paste these into Vercel → Project → Settings → Environment Variables.
# IMPORTANT: apply every variable to Production AND Preview, and to ALL services
# (frontend + backend). If Redis is only attached to the frontend, login/menu
# rate limits still see localhost and fail.
#
# Do not commit real secrets.

# --- Public site (both services) ---
PUBLIC_APP_URL=https://bowlbyte.vercel.app
CORS_ORIGINS=https://bowlbyte.vercel.app
COOKIE_SECURE=true
ENVIRONMENT=production
PROXY_SHARED_SECRET=replace-with-a-long-random-proxy-secret-at-least-24-chars

# --- Supabase Postgres (backend; frontend only needs the NEXT_PUBLIC_* keys) ---
# Session pooler :5432 with sslmode=verify-full. Do NOT add sslrootcert=C:/...
# Leave DATABASE_URL unset so the API rewrites SUPABASE_DB_URL automatically.
SUPABASE_DB_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=verify-full
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# --- Redis (backend MUST see this) ---
# After connecting Upstash/Marketplace Redis, confirm the env name is REDIS_URL
# (prefix REDIS → REDIS_URL). Use the rediss:// TLS URL. Never leave it as
# redis://127.0.0.1 or redis://localhost on Vercel.
REDIS_URL=rediss://default:PASSWORD@HOST:6379

# --- Mail / push (backend) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
PICKUP_HASH_KEY=
PUSH_ENCRYPTION_KEY=

# Do NOT set API_INTERNAL_URL in the dashboard. The frontend→backend service
# binding injects it at runtime for server components.
