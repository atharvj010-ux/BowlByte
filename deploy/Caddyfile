# TLS terminator for the isolated staging project.
# The browser talks only to Caddy. Caddy talks to the Next.js frontend.
# PostgreSQL, Redis, and Mailpit are not published.
#
# BOWLBYTE_SITE_ADDRESS=:443 and the default tls internal line are a local
# certificate. That is not a publicly trusted certificate and it does not
# prove phone push delivery.
#
# For a real name, set BOWLBYTE_SITE_ADDRESS to the hostname and mount
# deploy/Caddyfile.public instead. Do not use curl -k as evidence of trust.

{$BOWLBYTE_SITE_ADDRESS::443} {
	tls internal
	encode gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
	}
	reverse_proxy frontend:3000
}
